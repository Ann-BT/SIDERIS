# ─────────────────────────────────────────────────────────────────
# SIDERIS — Environment Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# ── Ports ────────────────────────────────────────────────────────
PROXY_PORT=4000          # User-facing proxy (attackers browse here)
INGEST_PORT=5000         # Telemetry collection (internal only)
DASHBOARD_PORT=6001      # SOC dashboard API  (internal only)

# ── Target website ───────────────────────────────────────────────
# The website SIDERIS will monitor and protect.
# Change these two lines to switch targets (no rebuild needed).
TARGET_URL=http://localhost:3000       # API/admin routes
STOREFRONT_URL=http://localhost:3000   # Main HTML pages

# ── Database ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://sideris:sideris@localhost:5432/sideris
INGEST_HOST=http://localhost:5000

# ── Dashboard access control ──────────────────────────────────────
# Comma-separated list of IPs/CIDR ranges allowed to view the dashboard.
# Only your team's IPs should be here — never expose to public internet.
DASHBOARD_ALLOWED_IPS=127.0.0.1,::1,192.168.0.0/16,10.0.0.0/8
